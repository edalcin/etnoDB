  "notas": {
    "agricultura": {
      "definition": "Atividade econômica de cultivo de espécies vegetais pela comunidade, para consumo próprio ou para venda.",
      "scopeNote": "Faceta de 1º nível das Atividades Econômicas. Cobre o cultivo deliberado; a obtenção de produto vegetal de população silvestre ou apenas manejada vai em `extrativismo vegetal`. A modalidade de agricultura (finalidade, escala, regime hídrico) fica sob `sistema agrícola`; a atividade nomeada pela espécie cultivada, sob `cultivo por espécie`. `lavrador` — a pessoa, não a atividade — é rótulo oculto deste conceito."
    },
    "sistema agrícola": {
      "definition": "Modalidade de agricultura definida pela finalidade da produção, pela escala do estabelecimento ou pelo regime hídrico, e não pela espécie cultivada.",
      "scopeNote": "Use para o termo que qualifica *como* ou *para quê* se cultiva (`agricultura de subsistência`, `de pequena escala`, `de sequeiro`). O termo que nomeia *o que* se cultiva vai em `cultivo por espécie`. Um termo pode pertencer aos dois ramos quando carrega as duas informações — é o caso de `produção de hortaliças orgânicas`."
    },
    "cultivo por espécie": {
      "definition": "Atividade agrícola nomeada pela espécie ou pelo grupo de espécies cultivado.",
      "scopeNote": "Reúne os termos da forma `cultivo de <espécie>` e as designações consagradas de uma lavoura específica (`produção canavieira`). A modalidade de agricultura, independente da espécie, fica em `sistema agrícola`."
    },
    "pecuária": {
      "definition": "Atividade econômica de criação de animais pela comunidade, para consumo próprio ou para venda.",
      "scopeNote": "Faceta de 1º nível. Abrange a criação de qualquer animal de produção, inclusive a de abelhas (`apicultura`), e não só o rebanho bovino ou caprino. A captura de animal em ambiente natural não é pecuária: a de organismos aquáticos vai em `atividade pesqueira`."
    },
    "criação de gado": {
      "definition": "Criação de bovinos, para corte, leite ou tração.",
      "scopeNote": "Entende-se `gado` como rebanho bovino — leitura que o próprio corpus sustenta, já que o termo composto `criação de gado e cabras` opõe gado a cabras. A criação de caprinos vai em `criação de cabras`."
    },
    "criação de cabras": {
      "definition": "Criação de caprinos, para corte, leite ou pele."
    },
    "atividade pesqueira": {
      "definition": "Atividade econômica de captura de peixes e de outros organismos aquáticos.",
      "scopeNote": "Faceta de 1º nível. Existe como nó próprio porque o conceito `pesca` já é compartilhado com o Campo Semântico \"Tipos de Usos de Plantas\", onde significa *planta empregada na pesca*: `pesca` recebe esta faceta como segundo pai (poli-hierarquia), e `pesca artesanal` é ligada diretamente a esta faceta para não herdar o ramo `material e tecnológico`, que não descreve atividade econômica."
    },
    "extrativismo vegetal": {
      "definition": "Obtenção de produto vegetal de população silvestre ou apenas manejada, sem cultivo deliberado.",
      "scopeNote": "Faceta de 1º nível. Inclui a coleta para consumo próprio, a exploração comercial e o manejo de população nativa — caso das sementes de juçara, que não chega a ser cultivo. O cultivo deliberado de espécie vegetal vai em `agricultura`."
    },
    "transformação artesanal": {
      "definition": "Beneficiamento artesanal de matéria-prima em produto, pela própria comunidade.",
      "scopeNote": "Faceta de 1º nível. Reúne tanto o artesanato propriamente dito quanto o beneficiamento artesanal de alimento e bebida (`fabricação artesanal de farinha`, `de aguardente`) — que não são artesanato e por isso são ligados à faceta, não a `artesanato`. O conceito `artesanato` é compartilhado com \"Tipos de Usos de Plantas\" e recebe esta faceta como segundo pai."
    },
    "comércio e serviços": {
      "definition": "Atividade econômica de venda de mercadoria ou de prestação de serviço pela comunidade.",
      "scopeNote": "Faceta de 1º nível. Abriga o comércio de mercadoria, o turismo e o serviço remunerado prestado por moradores, inclusive a `monitoria ambiental` executada em unidade de conservação. Não se confunde com a venda do próprio produto agrícola ou extrativo, que permanece no ramo da atividade que o produz — é por isso que `exploração do palmito para venda` fica em `extrativismo vegetal`."
    },
    "atividades domésticas": {
      "definition": "Trabalho de manutenção da casa e da família, executado sem remuneração.",
      "scopeNote": "Faceta de 1º nível, registrada porque as fontes a declaram entre as atividades econômicas das comunidades. Que o trabalho doméstico não remunerado seja ou não \"atividade econômica\" é questão em disputa na literatura econômica; o vocabulário preserva o que a fonte afirmou em vez de descartá-lo. `dona de casa` — a pessoa, não a atividade — é rótulo oculto deste conceito."
    },
    "pesca": {
      "scopeNote": "Conceito compartilhado por dois Campos Semânticos: em \"Tipos de Usos de Plantas\" significa *planta empregada na pesca* (daí o pai `material e tecnológico`); em \"Atividades Econômicas\" significa *a pesca como meio de vida da comunidade* (daí o pai `atividade pesqueira`). A poli-hierarquia é deliberada e as duas leituras respondem por este mesmo conceito."
    },
    "artesanato": {
      "scopeNote": "Conceito compartilhado por dois Campos Semânticos: em \"Tipos de Usos de Plantas\" significa *planta empregada em artesanato* (daí o pai `material e tecnológico`); em \"Atividades Econômicas\" significa *o artesanato como meio de vida da comunidade* (daí o pai `transformação artesanal`). A poli-hierarquia é deliberada."
    },
    "__indeterminado__": {
      "definition": "Destino terminal de termos que não nomeiam aquilo que o Campo Semântico registra: termo vazio, duvidoso ou sem conteúdo informativo.",
      "scopeNote": "Conceito de serviço, compartilhado por todos os Campos Semânticos. Recebe a depreciação de termos sem substituto legítimo — a alternativa, deixá-los `candidate` para sempre, é erro de curadoria (Manual §5). Usado em \"Tipos de Usos de Plantas\" (2026-08-07) e em \"Atividades Econômicas\" (2026-08-17, termo `estudante`).",
      "historyNote": "Definição generalizada em 2026-08-17: era \"Registro de uso sem informação suficiente para classificação\", redação presa ao campo \"Tipos de Usos de Plantas\". Reescrita para servir a qualquer Campo Semântico, quando a curadoria de \"Atividades Econômicas\" precisou do mesmo destino terminal para `estudante`."
    }
  },
