<!-- Summary Cards Row -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

  <!-- Comunidades Card -->
  <div class="dashboard-card bg-gradient-to-br from-forest-500 to-forest-700 text-white">
    <div class="dashboard-card-header">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <span class="dashboard-card-label">Total de Comunidades</span>
    </div>
    <div class="dashboard-card-value" id="community-count">-</div>
  </div>

  <!-- Evidências Card -->
  <div class="dashboard-card bg-gradient-to-br from-blue-500 to-blue-700 text-white">
    <div class="dashboard-card-header">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      <span class="dashboard-card-label">Evidências Aprovadas</span>
    </div>
    <div class="dashboard-card-value" id="evidence-count">-</div>
  </div>

  <!-- Plantas Card -->
  <div class="dashboard-card bg-gradient-to-br from-amber-500 to-amber-700 text-white">
    <div class="dashboard-card-header">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
      </svg>
      <span class="dashboard-card-label">Plantas Únicas</span>
    </div>
    <div class="dashboard-card-value" id="plant-count">-</div>
  </div>

  <!-- Autores Card -->
  <div class="dashboard-card bg-gradient-to-br from-purple-500 to-purple-700 text-white">
    <div class="dashboard-card-header">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      <span class="dashboard-card-label">Autores Únicos</span>
    </div>
    <div class="dashboard-card-value" id="author-count">-</div>
  </div>

</div>

<!-- Maps Row -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">

  <!-- Mapa de Evidências por Estado -->
  <div class="card">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Evidências por Estado</h3>
    <div id="map-references" class="w-full" style="min-height: 400px;"></div>
  </div>

  <!-- Mapa de Comunidades por Estado -->
  <div class="card">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Comunidades por Estado</h3>
    <div id="map-communities" class="w-full" style="min-height: 400px;"></div>
  </div>

</div>

<!-- Charts Row -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">

  <!-- Publicações por Ano -->
  <div class="card">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Publicações por Ano</h3>
    <div id="chart-publications" class="w-full" style="min-height: 300px;"></div>
  </div>

  <!-- Top 10 Plantas -->
  <div class="card">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Top 10 Plantas Mais Citadas</h3>
    <div id="chart-top-plants" class="w-full" style="min-height: 300px;"></div>
  </div>

</div>

<!-- Sankey Diagram Row -->
<div class="grid grid-cols-1 gap-6 mb-8">
  <div class="card">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">Tipos de Comunidade x Tipos de Uso</h3>
        <p class="text-sm text-gray-500">Relação entre os tipos de comunidades tradicionais e os tipos de uso das plantas</p>
        <p class="text-xs text-gray-400 mt-1">Termos sinônimos são agregados sob o Termo Preferencial curado no BioCultTermos.</p>
      </div>
      <div class="flex gap-2 mt-3 sm:mt-0" id="sankey-filters">
        <button type="button" data-limit="10" class="sankey-limit-btn px-3 py-1.5 text-sm font-medium rounded-md bg-forest-600 text-white hover:bg-forest-700 focus:outline-none focus:ring-2 focus:ring-forest-500">
          Top 10
        </button>
        <button type="button" data-limit="20" class="sankey-limit-btn px-3 py-1.5 text-sm font-medium rounded-md bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-forest-500">
          Top 20
        </button>
        <button type="button" data-limit="30" class="sankey-limit-btn px-3 py-1.5 text-sm font-medium rounded-md bg-gray-200 text-gray-700 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-forest-500">
          Top 30
        </button>
      </div>
    </div>
    <div id="chart-sankey" class="w-full" style="min-height: 500px;"></div>
  </div>
</div>

<!-- Tables Row -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">

  <!-- Top Autores -->
  <div class="card">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Top 10 Autores</h3>
    <div id="table-authors"></div>
  </div>

  <!-- Top Comunidades -->
  <div class="card">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Top 10 Comunidades por Plantas</h3>
    <div id="table-communities"></div>
  </div>

</div>

<!-- Additional Stats Row -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

  <!-- Evidências com Mais Comunidades -->
  <div class="card">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Evidências com Mais Comunidades</h3>
    <div id="table-ref-communities"></div>
  </div>

  <!-- Evidências com Mais Plantas -->
  <div class="card">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Evidências com Mais Plantas</h3>
    <div id="table-ref-plants"></div>
  </div>

</div>
