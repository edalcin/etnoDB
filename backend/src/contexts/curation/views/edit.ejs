<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> - BioCultDB</title>
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="stylesheet" href="/styles/curation/list.css">
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  <script src="https://unpkg.com/alpinejs@3.13.3" defer></script>
  <style>
    [x-cloak] { display: none !important; }
  </style>
</head>
<body class="min-h-screen bg-gray-50" x-data="{ communityCount: <%= evidence.comunidades.length %>, plantCounts: <%= JSON.stringify(evidence.comunidades.map(c => c.plantas.length)) %> }">

  <!-- Header -->
  <header class="bg-forest-700 text-white shadow-lg">
    <div class="container mx-auto px-4 py-4">
      <div class="flex items-center gap-4">
        <img src="/images/logo.png" alt="BioCultDB Logo" class="h-16 w-16">
        <div>
          <h1 class="text-2xl font-bold"><%= contextName %></h1>
          <p class="text-forest-100 text-sm"><%= contextDescription %></p>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="container mx-auto px-4 py-8">

    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm">
      <a href="/" class="text-forest-600 hover:text-forest-700">← Voltar para lista</a>
    </nav>

    <!-- Error Messages -->
    <% if (errors && errors.length > 0) { %>
      <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
        <h3 class="text-red-800 font-semibold mb-2">Erros de validação:</h3>
        <ul class="list-disc list-inside text-red-700">
          <% errors.forEach(error => { %>
            <li><%= error %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <!-- Status Section -->
    <%- include('partials/status-section', { evidence: evidence }) %>

    <!-- Evidence Edit Form -->
    <form method="POST" action="/evidence/update/<%= evidence.id %>" class="space-y-8">

      <!-- Evidence Metadata Section -->
      <section class="card">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">Dados da Evidência</h2>

        <div class="space-y-4">
          <!-- Title -->
          <div>
            <label class="form-label" for="titulo">
              Título <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="titulo"
              name="titulo"
              class="form-input"
              value="<%= evidence.titulo %>"
              required
              maxlength="500"
            >
          </div>

          <!-- Authors -->
          <div>
            <label class="form-label" for="autores">
              Autores <span class="text-red-500">*</span>
              <span class="text-gray-500 text-xs">(separados por vírgula)</span>
            </label>
            <input
              type="text"
              id="autores"
              name="autores"
              class="form-input"
              value="<%= evidence.autores.join(', ') %>"
              required
            >
          </div>

          <!-- Year -->
          <div>
            <label class="form-label" for="ano">
              Ano de Publicação <span class="text-red-500">*</span>
            </label>
            <input
              type="number"
              id="ano"
              name="ano"
              class="form-input"
              value="<%= evidence.ano %>"
              min="1500"
              max="2100"
              required
            >
          </div>

          <!-- Abstract -->
          <div>
            <label class="form-label" for="resumo">
              Resumo
            </label>
            <textarea
              id="resumo"
              name="resumo"
              class="form-input"
              rows="4"
              maxlength="5000"
            ><%= evidence.resumo || '' %></textarea>
          </div>

          <!-- DOI -->
          <div>
            <label class="form-label" for="DOI">
              DOI
            </label>
            <input
              type="text"
              id="DOI"
              name="DOI"
              class="form-input"
              value="<%= evidence.DOI || '' %>"
              maxlength="100"
            >
          </div>
        </div>
      </section>

      <!-- Communities Section -->
      <section>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold text-gray-900">Comunidades</h2>
          <button
            type="button"
            class="btn btn-secondary"
            @click="htmx.ajax('POST', '/evidence/<%= evidence.id %>/community/add', {
              target: '#communities-container',
              swap: 'beforeend',
              values: { communityIndex: communityCount }
            }).then(() => { communityCount++; plantCounts.push(1); })"
          >
            + Adicionar Comunidade
          </button>
        </div>

        <div id="communities-container" class="space-y-6">
          <!-- Existing communities -->
          <% evidence.comunidades.forEach((comunidade, idx) => { %>
            <%- include('partials/community-form', { communityIndex: idx, community: comunidade, evidenceId: evidence.id }) %>
          <% }); %>
        </div>
      </section>

      <!-- Submit Buttons -->
      <div class="flex justify-end gap-4">
        <a href="/" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          Salvar Alterações
        </button>
      </div>

    </form>

  </main>

  <!-- Footer -->
  <footer class="bg-gray-800 text-white py-6 mt-12">
    <div class="container mx-auto px-4 text-center">
      <p class="text-sm">BioCultDB - Base de Dados Etnobotânica</p>
      <p class="text-xs text-gray-400 mt-1">Eduardo Dalcin - 2025/2026</p>
      <p class="text-xs text-gray-400">
        <a href="https://github.com/edalcin/BioCultDB" target="_blank" class="hover:text-forest-300">https://github.com/edalcin/BioCultDB</a>
      </p>
    </div>
  </footer>

</body>
</html>
